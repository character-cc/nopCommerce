@model LoyaltyLevelModel

@{
    ViewBag.PageTitle = T("Plugins.Customer.Loyalty.LoyaltyLevel.Edit").Text;
    // NopHtml.SetActiveMenuItemSystemName("Customer roles");
    Layout = "_AdminLayout";
}

<form asp-controller="Loyalty" asp-action="Edit" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugins.Customer.Loyalty.LoyaltyLevel.Edit")
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="Configure">@T("Plugins.Customer.Loyalty.LoyaltyLevel.BackToList")</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i> @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.SaveContinue")
            </button>
            <span id="loyaltylevel-delete" class="btn btn-danger">
                <i class="far fa-trash-can"></i>
                @T("Admin.Common.Delete")
            </span>
        </div>
    </div>

    @await Html.PartialAsync("~/Plugins/Customer.Loyalty/Views/_CreateOrUpdate.cshtml", Model)
</form>
<nop-delete-confirmation asp-model-id="@Model.Id" asp-button-id="loyaltylevel-delete" />