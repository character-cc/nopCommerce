@inject Nop.Core.IWebHelper webHelper

@{
    Layout = "_ConfigurePlugin";
}

@model LoyaltyLevelSearchModel

@{
    ViewBag.PageTitle = T("Plugins.Customer.Loyalty.LoyaltyLevel.Title").Text;
}

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("Plugins.Customer.Loyalty.LoyaltyLevel.Title")
    </h1>
    <div class="float-right">
        <a asp-action="Create" asp-area="Admin" class="btn btn-primary">
            <i class="fas fa-square-plus"></i>
            @T("Admin.Common.AddNew")
        </a>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default">
                    <div class="card-body">
                        @await Html.PartialAsync("Table", new DataTablesModel
                   {
                       Name = "loyaltylevels-grid",
                       UrlRead = new DataUrl("List", "Loyalty", new RouteValueDictionary { ["area"] = "Admin" }),
                       Length = Model.PageSize,
                       LengthMenu = Model.AvailablePageSizes,
                       ColumnCollection = new List<ColumnProperty>
                        {
                        new ColumnProperty(nameof(LoyaltyLevelModel.FriendlyName))
                        {
                        Title = T("Plugins.Customer.Loyalty.LoyaltyLevel.FriendlyName").Text,
                        Width = "200"
                        },
                        new ColumnProperty(nameof(LoyaltyLevelModel.SystemName))
                        {
                        Title = T("Plugins.Customer.Loyalty.LoyaltyLevel.SystemName").Text,
                        Width = "200"
                        },
                        new ColumnProperty(nameof(LoyaltyLevelModel.MinimumSpentAmount))
                        {
                        Title = T("Plugins.Customer.Loyalty.LoyaltyLevel.MinimumSpentAmount").Text,
                        Width = "150"
                        },
                        new ColumnProperty(nameof(LoyaltyLevelModel.MinimumProductQuantity))
                        {
                        Title = T("Plugins.Customer.Loyalty.LoyaltyLevel.MinimumProductQuantity").Text,
                        Width = "150"
                        },
                        new ColumnProperty(nameof(LoyaltyLevelModel.Id))
                        {
                        Title = T("Admin.Common.Edit").Text,
                        Width = "100",
                        ClassName = NopColumnClassDefaults.Button,
                        Render = new RenderButtonEdit(new DataUrl("~/Admin/Loyalty/Edit"))
                        }
                        }
                   })
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
